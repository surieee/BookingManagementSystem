components:
  schemas:
    EventModel:
      required:
        - eventName
        - eventStatus
        - organizerId
        - typeOfEvent
        - venue
      type: object
      properties:
        eventId:
          type: string
        eventName:
          pattern: ^[A-Za-z0-9\s\-]+$
          type: string
        venue:
          pattern: ^[A-Za-z0-9\s\-]+$
          type: string
        price:
          minimum: 0
          type: number
          format: double
        eventDate:
          type: string
          format: date-time
        typeOfEvent:
          type: string
        eventDescription:
          type: string
        seatsAvailable:
          minimum: 0
          type: integer
          format: int32
        totalSeats:
          minimum: 1
          type: integer
          format: int32
        organizerId:
          type: string
        durationHours:
          minimum: 0
          type: integer
          format: int32
        durationMinutes:
          minimum: 0
          type: integer
          format: int32
        blocked:
          type: boolean
        eventStatus:
          type: string
    AccountModel:
      required:
        - accountName
        - email
        - password
        - role
        - username
      type: object
      properties:
        accountId:
          type: string
        username:
          pattern: ^[a-zA-Z0-9._-]{3,20}$
          type: string
        accountName:
          pattern: ^[A-Za-z\s]{1,100}$
          type: string
        age:
          type: integer
          format: int32
        role:
          pattern: ADMIN|USER|ORGANIZER
          type: string
        phoneNumber:
          pattern: ^\d{10,12}$
          type: string
        email:
          pattern: ^[\w-\.]+@[\w-]+\.[a-zA-Z]{2,4}$
          type: string
        password:
          pattern: ^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d@$!%*?&]{8,}$
          type: string
        blocked:
          type: boolean
    TicketRequest:
      type: object
      properties:
        userId:
          type: string
        eventId:
          type: string
        noOfTickets:
          type: integer
          format: int32
    PaymentRequestDto:
      type: object
      properties:
        userId:
          type: string
        amount:
          type: number
          format: double
    NotificationDto:
      required:
        - bookingId
        - eventName
        - message
        - priority
        - userId
      type: object
      properties:
        eventName:
          type: string
        message:
          type: string
        priority:
          type: string
        userId:
          type: string
        bookingId:
          type: string
    BookingRequestDTO:
      required:
        - eventName
        - userId
      type: object
      properties:
        userId:
          type: string
        eventName:
          type: string
        numberOfTickets:
          minimum: 1
          type: integer
          format: int32
    JwtRequest:
      type: object
      properties:
        username:
          type: string
        password:
          type: string
    ApiResponse:
      type: object
      properties:
        status:
          type: string
          enum:
            - SUCCESS
            - ERROR
            - FAILURE
        message:
          type: string
        data:
          type: object
