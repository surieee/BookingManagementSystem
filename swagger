openapi: 3.0.1
info:
  title: OpenAPI definition
  version: v0
servers:
  - url: http://localhost:8080
    description: Generated server url
paths:
  /api/event/{eventId}:
    get:
      tags:
        - event-controller
      operationId: getEventById
      parameters:
        - name: eventId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: OK
          content:
            application/json: # Specify the content type here
              schema:
                type: object
                properties:
                  eventId:
                    type: string
                    example: "12345"
                  eventName:
                    type: string
                    example: "Concert in the Park"
                  eventDate:
                    type: string
                    format: date-time
                    example: "2024-10-25T19:00:00Z"
                  location:
                    type: string
                    example: "Central Park, NY"
                  description:
                    type: string
                    example: "Join us for a wonderful evening of music and fun!"
                required:
                  - eventId
                  - eventName
                  - eventDate
                  - location

    put:
      tags:
        - event-controller
      operationId: updateEvent
      parameters:
        - name: eventId
          in: path
          required: true
          schema:
            type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EventModel'
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
    patch:
      tags:
        - event-controller
      operationId: blockEvent
      parameters:
        - name: eventId
          in: path
          required: true
          schema:
            type: string
      requestBody:
        content:
          application/json:
            schema:
              type: boolean
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
  /api/account/{accountId}:
    get:
      tags:
        - account-controller
      operationId: viewAccountById
      parameters:
        - name: accountId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: OK
          content:
            application/json: # Specify the content type here
              schema:
                type: object
                properties:
                  accountId:
                    type: string
                    example: "acc-12345"
                  username:
                    type: string
                    example: "john_doe"
                  accountName:
                    type: string
                    example: "John Doe"
                  age:
                    type: integer
                    example: 30
                  role:
                    type: string
                    example: "USER" # Could be ADMIN, ORGANIZER, etc.
                  phoneNumber:
                    type: string
                    example: "123-456-7890"
                  email:
                    type: string
                    example: "john.doe@example.com"
                required:
                  - accountId
                  - username
                  - accountName
                  - age
                  - role
                  - phoneNumber
                  - email

    put:
      tags:
        - account-controller
      operationId: updateAccount
      parameters:
        - name: accountId
          in: path
          required: true
          schema:
            type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AccountModel'
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
    delete:
      tags:
        - account-controller
      operationId: deleteAccount
      parameters:
        - name: accountId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
    patch:
      tags:
        - account-controller
      operationId: blockAccount
      parameters:
        - name: accountId
          in: path
          required: true
          schema:
            type: string
      requestBody:
        content:
          application/json:
            schema:
              type: boolean
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
  /api/ticket:
    post:
      tags:
        - ticket-controller
      operationId: createTickets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TicketRequest'
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
  /api/payment:
    get:
        tags:
          - payment-controller
        operationId: viewPaymentHistory
        parameters:
          - name: userId
            in: query
            required: true
            schema:
              type: string
        responses:
          '200':
            description: OK
            content:
              application/json: # Specify the content type here
                schema:
                  type: object
                  properties:
                    payments:
                      type: array
                      items:
                        type: object
                        properties:
                          paymentId:
                            type: string
                            example: "pay-67890"
                          billAmount:
                            type: number
                            format: double
                            example: 100.50
                          paymentStatus:
                            type: string
                            example: "COMPLETED" # Could also be "REFUNDED"
                          dateOfPayment:
                            type: string
                            format: date-time
                            example: "2024-10-20T14:30:00Z"
                    message:
                      type: string
                      example: "Payment history retrieved successfully."
                  required:
                    - payments
                    - message

    post:
      tags:
        - payment-controller
      operationId: makePayment
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PaymentRequestDto'
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
  /api/notification:
    post:
      tags:
        - notification-controller
      operationId: sendNotifications
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NotificationDto'
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
  /api/event:
    get:
      tags:
        - event-controller
      operationId: viewEvents
      responses:
        '200':
          description: OK
          content:
            application/json: # Specify the content type here
              schema:
                type: object
                properties:
                  events:
                    type: array
                    items:
                      type: object
                      properties:
                        eventId:
                          type: string
                          example: "ev-12345"
                        eventName:
                          type: string
                          example: "Concert in the Park"
                        eventDate:
                          type: string
                          format: date-time
                          example: "2024-10-25T19:00:00Z"
                        location:
                          type: string
                          example: "Central Park, NY"
                        description:
                          type: string
                          example: "Join us for an evening of music and fun!"
                  message:
                    type: string
                    example: "Events retrieved successfully."
                required:
                  - events
                  - message

    post:
      tags:
        - event-controller
      operationId: createEvent
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EventModel'
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
  /api/bookings:
    get:
      tags:
        - booking-controller
      operationId: viewBookings
      parameters:
        - name: eventName
          in: query
          required: false
          schema:
            type: string
        - name: userId
          in: query
          required: false
          schema:
            type: string
      responses:
        '200':
          description: OK
          content:
            application/json: # Specify the content type here
              schema:
                type: object
                properties:
                  bookings:
                    type: array
                    items:
                      type: object
                      properties:
                        bookingId:
                          type: string
                          example: "bk-98765"
                        eventId:
                          type: string
                          example: "ev-12345"
                        userId:
                          type: string
                          example: "acc-67890"
                        bookingDate:
                          type: string
                          format: date-time
                          example: "2024-10-20T14:30:00Z"
                        totalAmount:
                          type: number
                          format: double
                          example: 150.00
                  message:
                    type: string
                    example: "Bookings retrieved successfully."
                required:
                  - bookings
                  - message

    post:
      tags:
        - booking-controller
      operationId: bookTickets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BookingRequestDTO'
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
  /api/auth/register:
    post:
      tags:
        - auth-controller
      operationId: createUser
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AccountModel'
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
  /api/auth/logout:
    post:
      tags:
        - auth-controller
      operationId: logoutUser
      parameters:
        - name: Authorization
          in: header
          required: true
          schema:
            type: string
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
  /api/auth/login:
    post:
      tags:
        - auth-controller
      operationId: login
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/JwtRequest'
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object
  /api/ticket/{ticketId}/cancel:
    patch:
      tags:
        - ticket-controller
      operationId: cancelTicket
      parameters:
        - name: ticketId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                type: object

  /api/ticket/{accountId}:
    get:
      tags:
        - ticket-controller
      operationId: getTicketsByAccountId
      parameters:
        - name: accountId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: OK
          content:
            application/json: # Specify the content type here
              schema:
                type: object
                properties:
                  tickets:
                    type: array
                    items:
                      type: object
                      properties:
                        ticketId:
                          type: string
                          example: "tk-54321"
                        eventId:
                          type: string
                          example: "ev-12345"
                        accountId:
                          type: string
                          example: "acc-67890"
                        bookingDate:
                          type: string
                          format: date-time
                          example: "2024-10-20T14:30:00Z"
                        seatNumber:
                          type: string
                          example: "A12"
                  message:
                    type: string
                    example: "Tickets retrieved successfully."
                required:
                  - tickets
                  - message

  /api/notification/{userId}:
    get:
      tags:
        - notification-controller
      operationId: viewNotifications
      parameters:
        - name: userId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: OK
          content:
            application/json: # Specify the content type here
              schema:
                type: object
                properties:
                  notifications:
                    type: array
                    items:
                      type: object
                      properties:
                        notificationId:
                          type: string
                          example: "noti-12345"
                        message:
                          type: string
                          example: "Your booking for the event has been confirmed."
                        priority:
                          type: string
                          example: "HIGH" # Could be "MEDIUM", "LOW", etc.
                        userId:
                          type: string
                          example: "acc-67890"
                        timestamp:
                          type: string
                          format: date-time
                          example: "2024-10-20T14:30:00Z"
                  message:
                    type: string
                    example: "Notifications retrieved successfully."
                required:
                  - notifications
                  - message

  /api/notification/search:
   get:
    tags:
      - notification-controller
    operationId: searchNotificationsByPriority
    parameters:
      - name: userId
        in: query
        required: true
        schema:
          type: string
      - name: priority
        in: query
        required: false
        schema:
          type: string
    responses:
      '200':
        description: OK
        content:
          application/json: # Specify the content type here
            schema:
              type: object
              properties:
                notifications:
                  type: array
                  items:
                    type: object
                    properties:
                      notificationId:
                        type: string
                        example: "noti-67890"
                      message:
                        type: string
                        example: "Your ticket has been upgraded."
                      priority:
                        type: string
                        example: "HIGH" # Could be "MEDIUM", "LOW", etc.
                      userId:
                        type: string
                        example: "acc-12345"
                      timestamp:
                        type: string
                        format: date-time
                        example: "2024-10-21T09:00:00Z"
                message:
                  type: string
                  example: "Notifications retrieved successfully."
              required:
                - notifications
                - message

  /api/event/search:
    get:
      tags:
        - event-controller
      operationId: searchEvents
      parameters:
        - name: searchCriteria
          in: query
          required: true
          schema:
            type: object
            additionalProperties:
              type: string
      responses:
        '200':
          description: OK
          content:
            application/json: # Specify the content type here
              schema:
                type: object
                properties:
                  events:
                    type: array
                    items:
                      type: object
                      properties:
                        eventId:
                          type: string
                          example: "ev-54321"
                        eventName:
                          type: string
                          example: "Concert of the Year"
                        date:
                          type: string
                          format: date-time
                          example: "2024-10-25T19:00:00Z"
                        location:
                          type: string
                          example: "City Stadium"
                        description:
                          type: string
                          example: "An amazing concert featuring popular artists."
                  message:
                    type: string
                    example: "Events retrieved successfully."
                required:
                  - events
                  - message

  /api/event/blocked:
    get:
      tags:
        - event-controller
      operationId: viewBlockedEvents
      responses:
        '200':
          description: OK
          content:
            application/json: # Specify the content type here
              schema:
                type: object
                properties:
                  blockedEvents:
                    type: array
                    items:
                      type: object
                      properties:
                        eventId:
                          type: string
                          example: "ev-67890"
                        eventName:
                          type: string
                          example: "Annual Charity Gala"
                        date:
                          type: string
                          format: date-time
                          example: "2024-11-15T18:00:00Z"
                        location:
                          type: string
                          example: "Downtown Convention Center"
                        reason:
                          type: string
                          example: "Event has been postponed."
                  message:
                    type: string
                    example: "Blocked events retrieved successfully."
                required:
                  - blockedEvents
                  - message

  /api/account:
    get:
      tags:
        - account-controller
      operationId: getAllAccounts
      parameters:
        - name: blocked
          in: query
          required: false
          schema:
            type: boolean
        - name: page
          in: query
          required: false
          schema:
            type: integer
            format: int32
            default: 0
        - name: size
          in: query
          required: false
          schema:
            type: integer
            format: int32
            default: 10
      responses:
        '200':
          description: OK
          content:
            application/json: # Specify the content type here
              schema:
                type: object
                properties:
                  accounts:
                    type: array
                    items:
                      type: object
                      properties:
                        accountId:
                          type: string
                          example: "acc-12345"
                        username:
                          type: string
                          example: "john_doe"
                        accountName:
                          type: string
                          example: "John Doe"
                        age:
                          type: integer
                          example: 30
                        role:
                          type: string
                          example: "USER" # Could be "ADMIN", "ORGANIZER", etc.
                        email:
                          type: string
                          example: "john.doe@example.com"
                        blocked:
                          type: boolean
                          example: false
                  message:
                    type: string
                    example: "Accounts retrieved successfully."
                required:
                  - accounts
                  - message

  
components:
  schemas:
    EventModel:
      required:
        - eventName
        - eventStatus
        - organizerId
        - typeOfEvent
        - venue
      type: object
      properties:
        eventId:
          type: string
        eventName:
          pattern: ^[A-Za-z0-9\s\-]+$
          type: string
        venue:
          pattern: ^[A-Za-z0-9\s\-]+$
          type: string
        price:
          minimum: 0
          type: number
          format: double
        eventDate:
          type: string
          format: date-time
        typeOfEvent:
          type: string
        eventDescription:
          type: string
        seatsAvailable:
          minimum: 0
          type: integer
          format: int32
        totalSeats:
          minimum: 1
          type: integer
          format: int32
        organizerId:
          type: string
        durationHours:
          minimum: 0
          type: integer
          format: int32
        durationMinutes:
          minimum: 0
          type: integer
          format: int32
        blocked:
          type: boolean
        eventStatus:
          type: string
    AccountModel:
      required:
        - accountName
        - email
        - password
        - role
        - username
      type: object
      properties:
        accountId:
          type: string
        username:
          pattern: ^[a-zA-Z0-9._-]{3,20}$
          type: string
        accountName:
          pattern: ^[A-Za-z\s]{1,100}$
          type: string
        age:
          type: integer
          format: int32
        role:
          pattern: ADMIN|USER|ORGANIZER
          type: string
        phoneNumber:
          pattern: ^\d{10,12}$
          type: string
        email:
          pattern: ^[\w-\.]+@[\w-]+\.[a-zA-Z]{2,4}$
          type: string
        password:
          pattern: ^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d@$!%*?&]{8,}$
          type: string
        blocked:
          type: boolean
    TicketRequest:
      type: object
      properties:
        userId:
          type: string
        eventId:
          type: string
        noOfTickets:
          type: integer
          format: int32
    PaymentRequestDto:
      type: object
      properties:
        userId:
          type: string
        amount:
          type: number
          format: double
    NotificationDto:
      required:
        - bookingId
        - eventName
        - message
        - priority
        - userId
      type: object
      properties:
        eventName:
          type: string
        message:
          type: string
        priority:
          type: string
        userId:
          type: string
        bookingId:
          type: string
    BookingRequestDTO:
      required:
        - eventName
        - userId
      type: object
      properties:
        userId:
          type: string
        eventName:
          type: string
        numberOfTickets:
          minimum: 1
          type: integer
          format: int32
    JwtRequest:
      type: object
      properties:
        username:
          type: string
        password:
          type: string
    ApiResponse:
      type: object
      properties:
        status:
          type: string
          enum:
            - SUCCESS
            - ERROR
            - FAILURE
        message:
          type: string
        data:
          type: object
